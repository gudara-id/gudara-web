+    setSaving(true);
+    setMsg('');
+    try {
+      const res = await fetch('/api/admin/hero', {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          eyebrow,
