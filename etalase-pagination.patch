   if (sort === 'price-desc') return cards.sort((a, b) => b.price - a.price);
   return cards;
 }
+
+// Versi dengan pagination sungguhan untuk halaman etalase (bukan cuma
+// "limit" seperti getProductRow) — dipakai supaya produk ke-25 dst tetap
+// bisa diakses lewat nomor halaman, dan total produk yang ditampilkan
+// ("24 produk") mencerminkan jumlah SEBENARNYA di seluruh katalog, bukan
+// cuma jumlah yang kebetulan ke-fetch di satu halaman.
+export async function getProductPage(kat, page = 1, pageSize = 24, sort = 'newest', search = '', opts = {}) {
+  const supabase = getSupabase();
+  const safePage = Math.max(1, page);
+  const from = (safePage - 1) * pageSize;
+  const to = from + pageSize - 1;
+
+  let query = supabase
+    .from('products')
+    .select('id, slug, name, category, price, compare_price, created_at, product_images(url, sort_order)', {
+      count: 'exact',
+    })
+    .eq('is_active', true);
+
+  if (kat) query = query.eq('category', kat);
+  if (search && search.trim()) query = query.ilike('name', `%${search.trim()}%`);
+  if (!kat && opts.excludeCustom) query = query.neq('category', 'custom');
+
+  // Sort di level database (bukan di JS) supaya urutan tetap konsisten
+  // lintas halaman — sort di JS cuma benar kalau semua data ke-fetch
+  // sekaligus, yang justru tidak terjadi begitu ada pagination.
+  if (sort === 'price-asc') query = query.order('price', { ascending: true });
+  else if (sort === 'price-desc') query = query.order('price', { ascending: false });
+  else query = query.order('created_at', { ascending: false });
+
+  query = query.range(from, to);
+
+  const { data, error, count } = await query;
+  if (error) {
+    console.error('getProductPage failed:', error.message);
+    return { items: [], total: 0, page: safePage, pageSize, totalPages: 1 };
+  }
+
+  const total = count || 0;
+  const totalPages = Math.max(1, Math.ceil(total / pageSize));
+
+  return {
+    items: (data || []).map(normalizeCard),
+    total,
+    page: safePage,
+    pageSize,
+    totalPages,
+  };
+}
  
